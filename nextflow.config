docker {
    enabled         = true
    autoMounts      = true
    fixOwnership    = true
    remove          = true
    runOptions      = '-u $(id -u):$(id -g)'
}

manifest.name = 'playground'
manifest.description = 'playground'
manifest.version = null

params {
    input_samplesheet = "${projectDir}/../test_samplesheet.csv"

    // reference data
    fasta = "${projectDir}/../reference/Homo_sapiens_assembly38.fasta"
    fasta_fai = "${projectDir}/../reference/Homo_sapiens_assembly38.fasta.fai"
    dict = "${projectDir}/../reference/Homo_sapiens_assembly38.dict"
    bwa_index = "${projectDir}/../reference/Homo_sapiens_assembly38"
    mutect_interval = "${projectDir}/../reference/hg38_cds_corrected_sorted_merged.bed"
    
    dbsnp = "${projectDir}/../reference/dbsnp_146.hg38.vcf.gz"  
    dbsnp_tbi = "${projectDir}/../reference/dbsnp_146.hg38.vcf.gz.tbi"
    known_indels = "${projectDir}/../reference/Homo_sapiens_assembly38.known_indels.vcf.gz"
    known_indels_tbi = "${projectDir}/../reference/Homo_sapiens_assembly38.known_indels.vcf.gz.tbi"
    mills_and_1000G_gold_standard = "${projectDir}/../reference/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    mills_and_1000G_gold_standard_tbi = "${projectDir}/../reference/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
    germline_resource = "${projectDir}/../reference/af-only-gnomad.hg38.vcf.gz"
    germline_resource_tbi = "${projectDir}/../reference/af-only-gnomad.hg38.vcf.gz.tbi"
    panel_of_normals = "${projectDir}/../reference/1000g_pon.hg38.vcf.gz"
    panel_of_normals_tbi = "${projectDir}/../reference/1000g_pon.hg38.vcf.gz.tbi"
}

process {
    executor = 'local'
    withName: '.*PARABRICKS_MUTECTCALLER' {
        ext.args = {[
            "--mutect-f1r2-tar-gz ${meta.id}.f1r2.tar.gz",
            '--mutect-low-memory'
        ].join(' ').trim()}
        
    }
    withName: 'PARABRICKS.*' {
        stageInMode = 'symlink'
        maxForks = 1
        containerOptions = '--gpus all'
        cpus = 2
    }
    withName: 'PARABRICKS_FQ2BAM' {
        ext.args = {[
            '--low-memory --memory-limit 16',
            "--read-group-sm ${meta.id}",
            "--read-group-lb ${meta.id}",
            "--read-group-pl ${ meta.platform ?: "unknown" }",
            "--read-group-id-prefix ${meta.id}"
        ].join(' ').trim() }
    }
    withName: 'PARABRICKS_APPLYBQSR' {
        ext.prefix = { "${meta.id}_recalibrated" }
    }
    withName: 'GATK4_GETPILEUPSUMMARIES_TUMOR' {
        ext.prefix = { "${meta.id}_tumor" }
    }
    withName: 'GATK4_GETPILEUPSUMMARIES_NORMAL' {
        ext.prefix = { "${meta.id}_normal" }
    }
    withName: '.*GATK4_.*' {
        cpus = 1
        memory = '8 GB'
    }
    withName: 'GATK4_CALCULATECONTAMINATION' {
        ext.args = { "--tumor-segmentation ${meta.id}.tumor.segmentation.table" }
    }
    withName: 'GATK4_FILTERMUTECTCALLS' {
        ext.prefix = { "${meta.id}_filtered" }
    }
}
